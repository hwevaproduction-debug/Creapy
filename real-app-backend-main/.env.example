# Backend-specific environment variables (example)
# Sanitized example: DO NOT commit real secrets. Replace with values from your
# secret manager or CI/CD environment.

NODE_ENV=production
PORT=5000

# Database connection for backend
# Example format: postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://user:password@hostname:5432/creapy_db

# Authentication
# Use a strong, random JWT secret in production
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# CORS / Frontend
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com https://example.com

# Payments - set to 'stripe'|'paynow'|'mock'
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=sk_live_... (set in production secrets)
# PAYNOW_INTEGRATION_ID=
# PAYNOW_INTEGRATION_KEY=

# Email (Gmail / Nodemailer)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# SMS (Africa's Talking) - optional
SMS_ENABLED=false
SMS_PROVIDER=
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# Push notifications (VAPID) - optional
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# S3 File Uploads (optional)
# S3_BUCKET=your-bucket-name
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_REGION=us-east-1

# Uploads (local fallback)
STORAGE_PROVIDER=local
UPLOADS_DIR=/srv/uploads

# App base URL
APP_BASE_URL=https://api.example.com

# Feature flags and tuning
SKIP_EMAIL_VERIFICATION=false

# Notes:
# - Replace placeholders with real values in your deployment environment.
# - Never commit secrets into the repository.
