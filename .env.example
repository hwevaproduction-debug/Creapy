# Application environment variables (example)
# Do NOT store real secrets here. Replace placeholders in your deployments.

# App runtime
NODE_ENV=production            # one of 'production'|'development'|'test'
PORT=3000

# Database
# Replace with your database connection string. Example formats:
# postgres://user:pass@host:5432/dbname
DATABASE_URL=postgres://user:password@localhost:5432/creapy_db

# Authentication
# Provide a strong JWT secret in real deployments (do NOT commit actual secrets)
JWT_SECRET=your_jwt_secret_here

# Storage
STORAGE_PROVIDER=local        # 'local' or 's3'
UPLOADS_DIR=/srv/uploads
# If using S3, configure the following (examples commented out):
# S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=https://cdn.example.com

# Frontend / URLs
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Payment
# For production, set STRIPE_SECRET_KEY in production env (commented here)
# STRIPE_SECRET_KEY=sk_live_...
PAYMENT_PROVIDER=mock

# Misc
# Keep other third-party keys commented or set in secure vaults
