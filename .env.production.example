# Production environment example
# IMPORTANT: Do NOT store real secrets in this repository. Use your secret manager.

NODE_ENV=production
PORT=3000

# Database URL - set to your production DB
DATABASE_URL=postgres://<prod_user>:<prod_password>@<prod_host>:5432/<prod_db>

# JWT secret must be a strong random value in production
JWT_SECRET=<PRODUCTION_JWT_SECRET>

# Use S3 or a cloud storage provider in production
STORAGE_PROVIDER=s3
# S3_BUCKET should be set in your deployment environment
# S3_BUCKET=your-production-bucket
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=https://cdn.yourdomain.com
UPLOADS_DIR=/srv/uploads    # local path (used when STORAGE_PROVIDER=local)

# Frontend base URL (public)
APP_BASE_URL=https://app.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

# Payment provider - set real keys in secret manager
# STRIPE_SECRET_KEY=sk_live_...
PAYMENT_PROVIDER=stripe

# Notes:
# - Replace all <placeholders> with real values on deployment.
# - Keep secrets only in your secret management system or environment, not in git.
