# Development environment example
NODE_ENV=development
PORT=3000

# Local Postgres (change as needed)
DATABASE_URL=postgres://dev_user:dev_password@localhost:5432/creapy_dev

# Use a weak/local JWT secret for convenience in development only
JWT_SECRET=dev_jwt_secret

# Local storage for uploaded files during development
STORAGE_PROVIDER=local
UPLOADS_DIR=/srv/uploads
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:3000/uploads

# Frontend URL used for CORS and links
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Use mock payment provider in development
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY left commented in dev
# STRIPE_SECRET_KEY=
